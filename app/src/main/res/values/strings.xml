    <!-- Onboarding -->
    <string name="onboarding_title">Turn touch into tasks.</string>
    <string name="onboarding_subtitle">DroidFlow is a no-code Android agent. Describe what you want done — it observes, plans, acts, verifies and stops safely at risk boundaries.</string>
    <string name="onboarding_a11y">Built on Android Accessibility</string>
    <string name="onboarding_a11y_body">Android\'s accessibility system was built to empower users with disabilities. DroidFlow uses the very same technology as a no-code automation layer — so anyone can run tasks across apps without writing code and without waiting for per-app integrations.</string>
    <string name="perm_a11y_title">Accessibility permission</string>
    <string name="perm_a11y_body">Reads the UI structure of the current screen and performs only the taps and typing you approve.</string>
    <string name="perm_mic_title">Microphone</string>
    <string name="perm_mic_body">For voice tasks. Speech recognition runs on your device.</string>
    <string name="perm_net_title">Internet</string>
    <string name="perm_net_body">Connects to the Gemini AI planner — you provide your own API key.</string>
    <string name="perm_capture_title">Screen capture (later phase)</string>
    <string name="perm_capture_body">Optional visual fallback where accessibility data is insufficient. Secure screens are never bypassed.</string>
    <string name="restricted_title">Android 13+ note: \'Restricted settings\'</string>
    <string name="restricted_body">1. Settings → Apps → DroidFlow\n2. Tap ⋮ → Allow restricted settings\n3. Then enable the service below</string>
