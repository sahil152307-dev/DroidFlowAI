    <string name="about_lbl">About DroidFlow</string>
    <string name="about_body">DroidFlow observes, plans, acts, verifies and recovers — and stops when confidence or safety requirements are not met. The AI never controls the phone directly: it proposes one action at a time, and validation, safety and verification decide whether it happens.</string>

    <!-- Accessibility service -->
    <string name="accessibility_service_label">DroidFlow Agent</string>
    <string name="accessibility_service_description">DroidFlow reads the current screen to understand UI elements and perform the actions you approve. It never bypasses secure screens and pauses at high-risk steps.</string>

