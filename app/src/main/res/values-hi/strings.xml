    <!-- Onboarding -->
    <string name="onboarding_title">टच को टास्क में बदलिए।</string>
    <string name="onboarding_subtitle">DroidFlow एक नो-कोड Android एजेंट है। बताइए क्या करना है — यह देखता है, योजना बनाता है, कार्य करता है, जाँचता है और जोखिम पर सुरक्षित रुकता है।</string>
    <string name="onboarding_a11y">Android Accessibility पर निर्मित</string>
    <string name="onboarding_a11y_body">Android की accessibility तकनीक विशेष रूप से दिव्यांग उपयोगकर्ताओं के लिए बनाई गई थी। DroidFlow इसी तकनीक को नो-कोड ऑटोमेशन की परत बनाता है — ताकि कोई भी, बिना कोड लिखे और बिना ऐप-इंटीग्रेशन के इंतज़ार के, ऐप्स में काम करा सके।</string>
    <string name="perm_a11y_title">Accessibility अनुमति</string>
    <string name="perm_a11y_body">मौजूदा स्क्रीन का UI पढ़ता है और सिर्फ़ आपकी मंज़ूरी वाले टैप/टाइपिंग करता है।</string>
    <string name="perm_mic_title">माइक्रोफ़ोन</string>
    <string name="perm_mic_body">आवाज़ से काम बताने के लिए। बोली पहचान आपके डिवाइस पर चलती है।</string>
    <string name="perm_net_title">इंटरनेट</string>
    <string name="perm_net_body">Gemini AI प्लानर से जुड़ता है — API कुंजी आपकी अपनी।</string>
    <string name="perm_capture_title">स्क्रीन कैप्चर (बाद का चरण)</string>
    <string name="perm_capture_body">वैकल्पिक विज़ुअल सहायता, जहाँ accessibility डेटा कम हो। सुरक्षित स्क्रीन कभी बाईपास नहीं होती।</string>
    <string name="restricted_title">Android 13+ नोट: \'Restricted settings\'</string>
    <string name="restricted_body">1. Settings → Apps → DroidFlow\n2. ⋮ → Allow restricted settings\n3. फिर नीचे सर्विस चालू करें</string>
