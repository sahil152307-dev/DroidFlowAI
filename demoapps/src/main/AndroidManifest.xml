<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:label="DroidFlow Demo Apps"
        android:theme="@style/Theme.DemoApps">

        <!-- Each activity is a separate launcher entry: four "apps" in one APK.
             Distinct taskAffinity keeps each mock app in its OWN task so the
             agent can switch between them without stacking/clearing state. -->
        <activity
            android:name=".cab.RideNowActivity"
            android:exported="true"
            android:label="RideNow"
            android:icon="@mipmap/ic_ridenow"
            android:taskAffinity="com.demoapps.ridenow">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".cab.SwiftRideActivity"
            android:exported="true"
            android:label="SwiftRide"
            android:icon="@mipmap/ic_swiftride"
            android:taskAffinity="com.demoapps.swiftride">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".mart.MockMartActivity"
            android:exported="true"
            android:label="MockMart"
            android:icon="@mipmap/ic_mockmart"
            android:taskAffinity="com.demoapps.mockmart">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".form.QuickFormActivity"
            android:exported="true"
            android:label="QuickForm"
            android:icon="@mipmap/ic_quickform"
            android:taskAffinity="com.demoapps.quickform">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
